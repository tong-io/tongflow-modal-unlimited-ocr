{
    "plugin": {
        "name": "Unlimited OCR 2",
        "description": "Unlimited-horizon document parsing / OCR with Baidu Unlimited OCR 2 — images or hundred-page PDFs into Markdown in one pass.",
        "icon": "/plugins/tongflow-modal-unlimited-ocr.svg"
    },
    "env": [
        {
            "key": "MODAL_TOKEN_ID",
            "required": true,
            "description": "Modal token id",
            "url": "https://modal.com/settings/tokens"
        },
        {
            "key": "MODAL_TOKEN_SECRET",
            "required": true,
            "description": "Modal token secret (paired with MODAL_TOKEN_ID)"
        },
        {
            "key": "TONGFLOW_MODAL_CALL_TIMEOUT_S",
            "default": "3600",
            "description": "Max seconds to wait for a Modal call"
        }
    ]
}
